# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── CORS (producción) ──────────────────────────────────────────
# Orígenes permitidos para llamar al API, separados por coma.
# Pon aquí la URL de tu hosting estático (S3 website / CloudFront).
ALLOWED_ORIGINS=          # Ej. https://d1234abcd.cloudfront.net

# ── Frontend (build para S3) ────────────────────────────────────
# URL pública del backend en EC2. Se hornea en el bundle con:
#   VITE_API_URL=https://api.tudominio.com npm run build
VITE_API_URL=
